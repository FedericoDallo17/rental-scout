<div class="feed-layout search-workbench">
  <aside class="search-sidebar">
    <p class="search-sidebar__eyebrow">Rental Scout Lite</p>
    <h2><%= t("feed.saved_searches") %></h2>
    <p class="search-sidebar__copy"><%= t("feed.saved_searches_copy") %></p>
    <%= link_to t("feed.new_search"), new_search_preference_path, class: "search-sidebar__action" %>

    <nav class="search-sidebar__nav" aria-label="<%= t("feed.saved_searches_label") %>">
      <% @searches.each do |search| %>
        <div class="search-sidebar__item">
          <% search_path = search == @active_search ? listings_path(@feed_params) : listings_path(@feed_params.merge(search_id: search.id)) %>
          <%= link_to search_path, class: ["search-link", ("search-link--active" if search == @active_search)] do %>
            <span class="search-link__name"><%= search.name %></span>
          <span class="search-link__meta"><%= search.location_query %></span>
          <span class="search-link__count"><%= t("count.listing", count: @search_counts.fetch(search, 0)) %></span>
        <% end %>
          <%= link_to t("feed.edit"), edit_search_preference_path(search), class: "search-sidebar__edit" %>
        </div>
      <% end %>
    </nav>
  </aside>

  <main class="feed-main">
    <header class="feed-header">
      <div>
        <p class="feed-header__eyebrow"><%= t("feed.marketplace") %></p>
        <h1><%= t("feed.title") %></h1>
        <% if @active_search %>
          <p class="feed-header__context"><%= t("feed.browsing_html", name: @active_search.name) %></p>
        <% elsif @searches.any? %>
          <p class="feed-header__context"><%= t("feed.all_search_matches") %></p>
        <% end %>
        <% if @searches.any? %>
          <p class="feed-header__refresh-cue"><%= t("feed.refresh") %></p>
        <% end %>
      </div>

      <p class="feed-header__count"><%= t("count.listing", count: @listings.size) %></p>
    </header>

    <% if @searches.any? %>
      <%= form_with url: listings_path, method: :get, class: "feed-controls" do |form| %>
        <%= hidden_field_tag :search_id, @active_search.id if @active_search %>
        <div class="feed-controls__field">
          <%= form.label :sort, t("feed.sort") %>
          <%= form.select :sort, [
            [t("feed.sort_options.newest"), "newest"],
            [t("feed.sort_options.price_low"), "price_low"],
            [t("feed.sort_options.price_high"), "price_high"],
            [t("feed.sort_options.total_monthly"), "total_monthly"],
            [t("feed.sort_options.fit"), "fit"]
          ], selected: @sort %>
        </div>
        <div class="feed-controls__field">
          <%= form.label :source_id, t("feed.source") %>
          <%= form.select :source_id, @filter_sources.map { |source| [source.display_name, source.id] }, { include_blank: t("feed.all_sources") }, selected: @selected_source_id %>
        </div>
        <div class="feed-controls__field">
          <%= form.label :neighborhood, t("feed.neighborhood") %>
          <%= form.select :neighborhood, @filter_neighborhoods, { include_blank: t("feed.all_neighborhoods") }, selected: @selected_neighborhood %>
        </div>
        <div class="feed-controls__field">
          <%= form.label :currency, t("feed.currency") %>
          <%= form.select :currency, ListingsController::CURRENCIES, { include_blank: t("feed.all_currencies") }, selected: @selected_currency %>
        </div>
        <label class="feed-controls__toggle">
          <%= check_box_tag :expenses_known, "1", @expenses_known %>
          <span><%= t("feed.expenses_known") %></span>
        </label>
        <div class="feed-controls__actions">
          <%= form.submit t("feed.apply_controls"), class: "feed-controls__submit" %>
          <%= link_to t("feed.clear_controls"), listings_path(search_id: @active_search&.id), class: "feed-controls__clear" %>
        </div>
      <% end %>

      <% if @listings.any? %>
      <section class="listings-grid" aria-label="<%= t("feed.listings_label") %>">
        <% @listings.each do |listing| %>
      <article class="listing-card">
        <%= link_to listing.canonical_url, class: "listing-card__link", target: "_blank", rel: "noopener noreferrer" do %>
          <div class="listing-card__body">
            <% match_score = @listing_scores.fetch(listing) %>
            <div class="listing-card__summary">
              <p class="listing-card__price"><%= format_money(listing.price_cents, listing.currency) %></p>
              <% if match_score.score %>
                <p class="listing-card__score"><strong><%= match_score.score %></strong>/100 <%= t("feed.fit") %></p>
              <% end %>
            </div>
            <% if match_score.explanations.any? %>
              <p class="listing-card__explanation"><%= match_score.explanations.join(" · ") %></p>
            <% end %>
            <p class="listing-card__completeness"><%= match_score.completeness %></p>
            <% unless @active_search %>
              <p class="listing-card__matches"><%= t("feed.matches_searches", searches: @listing_matches.fetch(listing).map(&:name).to_sentence) %></p>
            <% end %>
            <h2><%= listing.title %></h2>
            <p class="listing-card__location"><%= listing.display_location %></p>
            <dl class="listing-card__facts">
              <div>
                <dt><%= t("feed.bedrooms") %></dt>
                <dd><%= listing.bedrooms || "-" %></dd>
              </div>
              <div>
                <dt>m²</dt>
                <dd><%= listing.square_meters || "-" %></dd>
              </div>
              <div>
                <dt><%= t("feed.expenses") %></dt>
                <dd><%= format_money(listing.expenses_cents, listing.expenses_currency.presence || listing.currency) || "-" %></dd>
              </div>
              <div>
                <dt><%= t("feed.parking") %></dt>
                <dd><%= listing.parking_spaces.nil? ? "-" : listing.parking_spaces %></dd>
              </div>
              <div class="listing-card__fact--source">
                <dt><%= t("feed.source") %></dt>
                <dd><%= listing.listing_source.display_name %></dd>
              </div>
            </dl>
            <p class="listing-card__url"><%= listing.canonical_url %></p>
          </div>
        <% end %>
      </article>
        <% end %>
      </section>
      <% else %>
        <section class="feed-empty-state" aria-label="<%= t("feed.no_results_label") %>">
          <h2><%= t("feed.no_results_title") %></h2>
          <p><%= t("feed.no_results_copy") %></p>
        </section>
      <% end %>
    <% else %>
      <section class="feed-empty-state" aria-label="<%= t("feed.setup_label") %>">
        <h2><%= t("feed.empty_title") %></h2>
        <p><%= t("feed.empty_copy") %></p>
      </section>
    <% end %>
  </main>
</div>
