<div class="feed-layout search-workbench">
  <aside class="search-sidebar">
    <p class="search-sidebar__eyebrow">Rental Scout Lite</p>
    <h2>Saved searches</h2>
    <p class="search-sidebar__copy">Jump back into the neighborhoods you check most often.</p>
    <%= link_to "New search", new_search_preference_path, class: "search-sidebar__action" %>

    <nav class="search-sidebar__nav" aria-label="Saved searches">
      <% @searches.each do |search| %>
        <div class="search-sidebar__item">
          <%= link_to listings_path(search_id: search.id), class: ["search-link", ("search-link--active" if search == @active_search)] do %>
            <span class="search-link__name"><%= search.name %></span>
          <span class="search-link__meta"><%= search.location_query %></span>
          <span class="search-link__count"><%= pluralize(@search_counts.fetch(search, 0), "listing") %></span>
        <% end %>
          <%= link_to "Edit", edit_search_preference_path(search), class: "search-sidebar__edit" %>
        </div>
      <% end %>
    </nav>
  </aside>

  <main class="feed-main">
    <header class="feed-header">
      <div>
        <p class="feed-header__eyebrow">Marketplace feed</p>
        <h1>Scraped Apartments</h1>
        <% if @active_search %>
          <p class="feed-header__context">Browsing <strong><%= @active_search.name %></strong></p>
          <p class="feed-header__refresh-cue">Updated automatically as new matches land.</p>
        <% end %>
      </div>

      <p class="feed-header__count"><%= pluralize(@listings.size, "listing") %></p>
    </header>

    <% if @active_search %>
      <section class="listings-grid" aria-label="Listings">
        <% @listings.each do |listing| %>
      <article class="listing-card">
        <%= link_to listing.canonical_url, class: "listing-card__link", target: "_blank", rel: "noopener noreferrer" do %>
          <div class="listing-card__image">Photo</div>
          <div class="listing-card__body">
            <p class="listing-card__price"><%= number_to_currency(listing.price_cents.to_i / 100.0, unit: "#{listing.currency.presence || "$"} ", precision: 0) if listing.price_cents %></p>
            <h2><%= listing.title %></h2>
            <p class="listing-card__location"><%= listing.location_text %></p>
            <dl class="listing-card__facts">
              <div>
                <dt>Bedrooms</dt>
                <dd><%= listing.bedrooms || "-" %></dd>
              </div>
              <div>
                <dt>m²</dt>
                <dd><%= listing.square_meters || "-" %></dd>
              </div>
              <div>
                <dt>Expenses</dt>
                <dd><%= listing.expenses_cents ? number_to_currency(listing.expenses_cents / 100.0, unit: "#{listing.expenses_currency.presence || listing.currency.presence || "$"} ", precision: 0) : "-" %></dd>
              </div>
              <div>
                <dt>Parking</dt>
                <dd><%= listing.parking_spaces.nil? ? "-" : listing.parking_spaces %></dd>
              </div>
              <div>
                <dt>Type</dt>
                <dd><%= listing.property_type.presence || "-" %></dd>
              </div>
              <div>
                <dt>Source</dt>
                <dd><%= listing.listing_source.name %></dd>
              </div>
            </dl>
            <p class="listing-card__url"><%= listing.canonical_url %></p>
          </div>
        <% end %>
      </article>
        <% end %>
      </section>
    <% else %>
      <section class="feed-empty-state" aria-label="Saved search setup">
        <h2>Save your first search to start a feed tailored to you.</h2>
        <p>Pick a neighborhood and budget once, then come back to a browsing view built around that search.</p>
      </section>
    <% end %>
  </main>
</div>
