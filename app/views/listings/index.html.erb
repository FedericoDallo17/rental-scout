<div class="feed-layout search-workbench">
  <aside class="search-sidebar">
    <p class="search-sidebar__eyebrow">Rental Scout Lite</p>
    <h2><%= t("feed.saved_searches") %></h2>
    <p class="search-sidebar__copy"><%= t("feed.saved_searches_copy") %></p>
    <%= link_to t("feed.new_search"), new_search_preference_path, class: "search-sidebar__action" %>

    <nav class="search-sidebar__nav" aria-label="<%= t("feed.saved_searches_label") %>">
      <% @searches.each do |search| %>
        <div class="search-sidebar__item">
          <% search_path = search == @active_search ? listings_path(@feed_params) : listings_path(@feed_params.merge(search_id: search.id)) %>
          <%= link_to search_path, class: ["search-link", ("search-link--active" if search == @active_search)] do %>
            <span class="search-link__name"><%= search.name %></span>
          <span class="search-link__meta"><%= search.location_query %></span>
          <span class="search-link__count"><%= t("count.listing", count: @search_counts.fetch(search, 0)) %></span>
        <% end %>
          <%= link_to edit_search_preference_path(search),
            class: "search-sidebar__edit",
            aria: { label: t("feed.edit_search", name: search.name) },
            title: t("feed.edit") do %>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M4 20h4l10.5-10.5a2.8 2.8 0 0 0-4-4L4 16v4Zm11.2-12.8 1.6 1.6" />
            </svg>
          <% end %>
        </div>
      <% end %>
    </nav>
  </aside>

  <main class="feed-main">
    <header class="feed-header">
      <div>
        <p class="feed-header__eyebrow"><%= t("feed.marketplace") %></p>
        <h1><%= t("feed.title") %></h1>
        <% if @active_search %>
          <p class="feed-header__context"><%= t("feed.browsing_html", name: @active_search.name) %></p>
        <% elsif @searches.any? %>
          <p class="feed-header__context"><%= t("feed.all_search_matches") %></p>
        <% end %>
        <% if @searches.any? %>
          <p class="feed-header__refresh-cue"><%= t("feed.refresh") %></p>
        <% end %>
      </div>

      <p class="feed-header__count"><%= t("count.listing", count: @total_listings) %></p>
    </header>

    <% if @searches.any? %>
      <%= form_with url: listings_path, method: :get, class: "feed-controls" do |form| %>
        <%= hidden_field_tag :search_id, @active_search.id if @active_search %>
        <div class="feed-controls__field">
          <%= form.label :sort, t("feed.sort") %>
          <%= form.select :sort, [
            [t("feed.sort_options.newest"), "newest"],
            [t("feed.sort_options.price_low"), "price_low"],
            [t("feed.sort_options.price_high"), "price_high"],
            [t("feed.sort_options.total_monthly"), "total_monthly"],
            [t("feed.sort_options.price_per_m2_low"), "price_per_m2_low"],
            [t("feed.sort_options.price_per_m2_high"), "price_per_m2_high"],
            [t("feed.sort_options.fit"), "fit"]
          ], selected: @sort %>
        </div>
        <div class="feed-controls__field">
          <%= form.label :source_id, t("feed.source") %>
          <%= form.select :source_id, @filter_sources.map { |source| [source.display_name, source.id] }, { include_blank: t("feed.all_sources"), selected: @selected_source_id } %>
        </div>
        <div class="feed-controls__field">
          <%= form.label :neighborhood, t("feed.neighborhood") %>
          <%= form.select :neighborhood, @filter_zones.map { |zone| [zone.name, zone.slug] }, { include_blank: t("feed.all_neighborhoods"), selected: @selected_neighborhood } %>
        </div>
        <div class="feed-controls__field">
          <%= form.label :min_bedrooms, t("feed.bedrooms") %>
          <%= form.select :min_bedrooms, [
            [t("feed.any_bedrooms"), ""],
            [t("feed.bedroom_options.studio_plus"), 0],
            [t("feed.bedroom_options.one_plus"), 1],
            [t("feed.bedroom_options.two_plus"), 2],
            [t("feed.bedroom_options.three_plus"), 3],
            [t("feed.bedroom_options.four_plus"), 4]
          ], selected: @min_bedrooms %>
        </div>
        <fieldset class="feed-price-filter">
          <legend><%= t("feed.price") %></legend>
          <div class="feed-price-filter__currency" aria-label="<%= t("feed.currency") %>">
            <%= radio_button_tag :currency, "", @selected_currency.nil?, id: "currency_all" %>
            <%= label_tag :currency_all, t("feed.all_currency_short") %>
            <%= radio_button_tag :currency, "UYU", @selected_currency == "UYU", id: "currency_uyu" %>
            <%= label_tag :currency_uyu, "$" %>
            <%= radio_button_tag :currency, "USD", @selected_currency == "USD", id: "currency_usd" %>
            <%= label_tag :currency_usd, "U$S" %>
          </div>
          <div class="feed-price-filter__range">
            <%= form.number_field :min_price, value: @min_price, min: 0, step: 1000, placeholder: t("feed.min_price_short"), aria: { label: t("feed.min_price") } %>
            <span aria-hidden="true">–</span>
            <%= form.number_field :max_price, value: @max_price, min: 0, step: 1000, placeholder: t("feed.max_price_short"), aria: { label: t("feed.max_price") } %>
          </div>
          <label class="feed-price-filter__expenses">
            <%= check_box_tag :include_expenses, "1", @cost_basis == "total" %>
            <span><%= t("feed.include_expenses") %></span>
          </label>
        </fieldset>
        <fieldset class="feed-range-filter">
          <legend><%= t("feed.surface_area") %></legend>
          <div class="feed-range-filter__inputs">
            <%= form.number_field :min_square_meters, value: @min_square_meters, min: 0, step: 1, placeholder: t("feed.min_area_short"), aria: { label: t("feed.min_area") } %>
            <span aria-hidden="true">–</span>
            <%= form.number_field :max_square_meters, value: @max_square_meters, min: 0, step: 1, placeholder: t("feed.max_area_short"), aria: { label: t("feed.max_area") } %>
          </div>
          <label>
            <%= hidden_field_tag :include_unknown_area, "0" %>
            <%= check_box_tag :include_unknown_area, "1", @include_unknown_area %>
            <span><%= t("feed.include_unknown_area") %></span>
          </label>
        </fieldset>
        <fieldset class="feed-range-filter">
          <legend><%= t("feed.max_expenses") %></legend>
          <div class="feed-range-filter__inputs feed-range-filter__inputs--expenses">
            <%= form.select :expenses_currency, [["$", "UYU"], ["U$S", "USD"]], { selected: @expenses_currency }, aria: { label: t("feed.expenses_currency") } %>
            <%= form.number_field :max_expenses, value: @max_expenses, min: 0, step: 500, placeholder: t("feed.max_expenses_short"), aria: { label: t("feed.max_expenses") } %>
          </div>
          <label>
            <%= hidden_field_tag :include_unknown_expenses, "0" %>
            <%= check_box_tag :include_unknown_expenses, "1", @include_unknown_expenses %>
            <span><%= t("feed.include_unknown_expenses") %></span>
          </label>
        </fieldset>
        <% if @filter_property_types.any? %>
          <div class="feed-controls__field">
            <%= form.label :property_type, t("feed.property_type") %>
            <%= form.select :property_type, @filter_property_types, { include_blank: t("feed.all_property_types"), selected: @selected_property_type } %>
          </div>
        <% end %>
        <% if @parking_filter_available %>
          <label class="feed-controls__checkbox">
            <%= check_box_tag :parking_required, "1", @parking_required %>
            <span><%= t("feed.parking_required") %></span>
          </label>
        <% end %>
        <div class="feed-controls__actions">
          <%= form.submit t("feed.apply_controls"), class: "feed-controls__submit" %>
          <%= link_to t("feed.clear_controls"), listings_path(search_id: @active_search&.id), class: "feed-controls__clear" %>
        </div>
      <% end %>

      <% if @listings.any? %>
      <section class="listings-grid" aria-label="<%= t("feed.listings_label") %>">
        <% @listings.each do |listing| %>
      <article class="listing-card">
        <%= link_to listing.canonical_url, class: "listing-card__link", target: "_blank", rel: "noopener noreferrer" do %>
          <div class="listing-card__body">
            <% match_score = @listing_scores.fetch(listing) %>
            <div class="listing-card__summary">
              <p class="listing-card__price"><%= format_money(listing.price_cents, listing.currency) %></p>
              <% if match_score.score %>
                <p class="listing-card__score"><strong><%= match_score.score %></strong>/100 <%= t("feed.fit") %></p>
              <% end %>
            </div>
            <% if match_score.explanations.any? %>
              <p class="listing-card__explanation"><%= match_score.explanations.join(" · ") %></p>
            <% end %>
            <p class="listing-card__completeness"><%= match_score.completeness %></p>
            <% unless @active_search %>
              <p class="listing-card__matches"><%= t("feed.matches_searches", searches: @listing_matches.fetch(listing).map(&:name).to_sentence) %></p>
            <% end %>
            <h2><%= listing.title %></h2>
            <p class="listing-card__location"><%= listing.display_location %></p>
            <dl class="listing-card__facts">
              <div>
                <dt><%= t("feed.bedrooms") %></dt>
                <dd><%= listing.bedrooms || "-" %></dd>
              </div>
              <div>
                <dt>m²</dt>
                <dd><%= listing.square_meters || "-" %></dd>
              </div>
              <div>
                <dt><%= t("feed.price_per_m2") %></dt>
                <dd><%= format_money(listing.price_per_square_meter_cents, listing.currency) || "-" %></dd>
              </div>
              <div>
                <dt><%= t("feed.expenses") %></dt>
                <dd><%= format_money(listing.expenses_cents, listing.expenses_currency.presence || listing.currency) || "-" %></dd>
              </div>
              <div>
                <dt><%= t("feed.parking") %></dt>
                <dd><%= listing.parking_spaces.nil? ? "-" : listing.parking_spaces %></dd>
              </div>
              <div class="listing-card__fact--source">
                <dt><%= t("feed.source") %></dt>
                <dd><%= listing.listing_source.display_name %></dd>
              </div>
            </dl>
            <p class="listing-card__url"><%= listing.canonical_url %></p>
          </div>
        <% end %>
      </article>
        <% end %>
      </section>
      <% if @total_pages > 1 %>
        <nav class="feed-pagination" aria-label="<%= t("feed.pagination") %>">
          <% if @page > 1 %>
            <%= link_to t("feed.previous_page"), listings_path(@feed_params.merge(search_id: @active_search&.id, page: @page - 1)) %>
          <% end %>
          <span><%= t("feed.page_status", page: @page, total: @total_pages) %></span>
          <% if @page < @total_pages %>
            <%= link_to t("feed.next_page"), listings_path(@feed_params.merge(search_id: @active_search&.id, page: @page + 1)) %>
          <% end %>
        </nav>
      <% end %>
      <% else %>
        <section class="feed-empty-state" aria-label="<%= t("feed.no_results_label") %>">
          <h2><%= t("feed.no_results_title") %></h2>
          <p><%= t("feed.no_results_copy") %></p>
        </section>
      <% end %>
    <% else %>
      <section class="feed-empty-state" aria-label="<%= t("feed.setup_label") %>">
        <h2><%= t("feed.empty_title") %></h2>
        <p><%= t("feed.empty_copy") %></p>
      </section>
    <% end %>
  </main>
</div>
