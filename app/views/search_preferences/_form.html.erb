<div class="search-form-shell" data-search-preview-root data-phone-notifications-configured="<%= current_user.pushover_user_key.present? || current_user.push_subscriptions.exists? %>">
  <%= form_with model: search_preference, class: "search-form search-form-panel" do |form| %>
    <% if search_preference.errors.any? %>
      <div class="form-errors">
        <h2><%= t("searches.save_error") %></h2>
        <ul>
          <% search_preference.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="search-form__grid">
      <div class="search-form__field">
        <%= form.label :name, t("searches.name") %>
        <%= form.text_field :name, autofocus: true %>
      </div>

      <div class="search-form__field">
        <%= form.label :location_query, t("searches.location") %>
        <%= form.text_field :location_query %>
      </div>

    </div>

    <div class="search-form__field search-form__bedrooms">
      <%= form.label :min_bedrooms, t("feed.bedrooms") %>
      <%= form.select :min_bedrooms, [
        [t("feed.any_bedrooms"), ""],
        [t("feed.bedroom_options.studio_plus"), 0],
        [t("feed.bedroom_options.one_plus"), 1],
        [t("feed.bedroom_options.two_plus"), 2],
        [t("feed.bedroom_options.three_plus"), 3],
        [t("feed.bedroom_options.four_plus"), 4]
      ] %>
    </div>

    <fieldset class="feed-price-filter search-form__price-filter">
      <legend><%= t("feed.price") %></legend>
      <div class="feed-price-filter__currency" aria-label="<%= t("feed.currency") %>">
        <%= form.radio_button :price_currency, "UYU", id: "search_currency_uyu" %>
        <%= label_tag :search_currency_uyu, "$" %>
        <%= form.radio_button :price_currency, "USD", id: "search_currency_usd" %>
        <%= label_tag :search_currency_usd, "U$S" %>
      </div>
      <div class="feed-price-filter__range">
        <%= form.number_field :min_price, min: 0, step: 1000, placeholder: t("feed.min_price_short"), aria: { label: t("feed.min_price") } %>
        <span aria-hidden="true">–</span>
        <%= form.number_field :max_price, min: 0, step: 1000, placeholder: t("feed.max_price_short"), aria: { label: t("feed.max_price") } %>
      </div>
      <label class="feed-price-filter__expenses">
        <%= form.check_box :include_expenses %>
        <span><%= t("feed.include_expenses") %></span>
      </label>
    </fieldset>

    <fieldset class="feed-range-filter search-form__area-filter">
      <legend><%= t("feed.surface_area") %> (m²)</legend>
      <div class="feed-range-filter__inputs">
        <%= form.number_field :min_square_meters, min: 0, step: 1, placeholder: t("feed.min_area_short"), aria: { label: t("feed.min_area") } %>
        <span aria-hidden="true">–</span>
        <%= form.number_field :max_square_meters, min: 0, step: 1, placeholder: t("feed.max_area_short"), aria: { label: t("feed.max_area") } %>
      </div>
      <p><%= t("tracking.search_area_hint") %></p>
    </fieldset>

    <fieldset class="search-form__zones">
      <legend><%= t("searches.neighborhoods") %></legend>
      <% zones.each do |zone| %>
        <label>
          <%= check_box_tag "search_preference[zone_ids][]", zone.id, search_preference.zone_ids.include?(zone.id) %>
          <span><%= zone.name %></span>
        </label>
      <% end %>
      <%= hidden_field_tag "search_preference[zone_ids][]", "" %>
    </fieldset>

    <label class="search-form__toggle">
      <%= form.check_box :notifications_enabled %>
      <span><%= t("searches.notify") %></span>
    </label>
    <p class="search-form__notification-warning"
      data-search-notification-warning
      <%= "hidden" unless search_preference.notifications_enabled? && current_user.pushover_user_key.blank? && current_user.push_subscriptions.none? %>>
      <%= t("searches.notification_setup_warning") %>
      <%= link_to t("searches.connect_phone_notifications"), edit_notification_settings_path %>
    </p>

    <div class="search-form__actions">
      <%= form.submit search_preference.persisted? ? t("searches.save") : t("searches.create"), class: "search-form__submit" %>
      <%= link_to t("searches.cancel"), listings_path(search_id: search_preference.id), class: "search-form__cancel" %>
    </div>
  <% end %>

  <aside class="search-form-aside" aria-label="<%= t("searches.context") %>">
    <p class="search-form-aside__eyebrow"><%= t("searches.preview") %></p>
    <h2><%= search_preference.name.presence || t("searches.new_title") %></h2>
    <p><%= t("searches.preview_copy") %></p>
    <div class="search-form-aside__facts"
      data-zone-one="<%= t("count.zone", count: 1) %>"
      data-zone-other="<%= t("count.zone", count: 2).sub("2", "%{count}") %>"
      data-notifications-on="<%= t("searches.notifications_on") %>"
      data-notifications-off="<%= t("searches.notifications_off") %>">
      <span data-search-preview-zones><%= t("count.zone", count: search_preference.zones.size) %></span>
      <span data-search-preview-bedrooms><%= t("feed.any_bedrooms") %></span>
      <span data-search-preview-price><%= t("searches.any_price") %></span>
      <span data-search-preview-area><%= t("tracking.any_area") %></span>
      <span data-search-preview-notifications><%= search_preference.notifications_enabled? ? t("searches.notifications_on") : t("searches.notifications_off") %></span>
    </div>
  </aside>
</div>

<%= javascript_tag nonce: true do %>
  (() => {
    const root = document.querySelector("[data-search-preview-root]");
    if (!root || root.dataset.previewReady) return;
    root.dataset.previewReady = "true";

    const form = root.querySelector("form.search-form");
    const title = root.querySelector(".search-form-aside h2");
    const facts = root.querySelector(".search-form-aside__facts");
    const zones = root.querySelector("[data-search-preview-zones]");
    const bedrooms = root.querySelector("[data-search-preview-bedrooms]");
    const price = root.querySelector("[data-search-preview-price]");
    const area = root.querySelector("[data-search-preview-area]");
    const notifications = root.querySelector("[data-search-preview-notifications]");
    const notificationWarning = root.querySelector("[data-search-notification-warning]");

    const update = () => {
      const name = form.querySelector("[name='search_preference[name]']").value.trim();
      title.textContent = name || <%= t("searches.new_title").to_json.html_safe %>;

      const zoneCount = form.querySelectorAll("input[name='search_preference[zone_ids][]'][type='checkbox']:checked").length;
      zones.textContent = zoneCount === 1 ? facts.dataset.zoneOne : facts.dataset.zoneOther.replace("%{count}", zoneCount);

      const bedroomSelect = form.querySelector("[name='search_preference[min_bedrooms]']");
      bedrooms.textContent = bedroomSelect.options[bedroomSelect.selectedIndex].text;

      const currency = form.querySelector("[name='search_preference[price_currency]']:checked");
      const currencyLabel = currency ? form.querySelector(`label[for='${currency.id}']`).textContent.trim() : "";
      const min = form.querySelector("[name='search_preference[min_price]']").value;
      const max = form.querySelector("[name='search_preference[max_price]']").value;
      const range = min && max ? `${currencyLabel} ${min}–${max}` : min ? `${<%= t("feed.min_price_short").to_json.html_safe %>} ${currencyLabel} ${min}` : max ? `${<%= t("feed.max_price_short").to_json.html_safe %>} ${currencyLabel} ${max}` : <%= t("searches.any_price").to_json.html_safe %>;
      const includesExpenses = form.querySelector("[name='search_preference[include_expenses]']").checked;
      price.textContent = includesExpenses && (min || max) ? `${range} · ${<%= t("searches.expenses_included_short").to_json.html_safe %>}` : range;

      const notify = form.querySelector("[name='search_preference[notifications_enabled]'][type='checkbox']").checked;
      const minArea = form.querySelector("[name='search_preference[min_square_meters]']").value;
      const maxArea = form.querySelector("[name='search_preference[max_square_meters]']").value;
      area.textContent = minArea && maxArea ? `${minArea}–${maxArea} m²` : minArea ? `≥ ${minArea} m²` : maxArea ? `≤ ${maxArea} m²` : <%= t("tracking.any_area").to_json.html_safe %>;
      notifications.textContent = notify ? facts.dataset.notificationsOn : facts.dataset.notificationsOff;
      notificationWarning.hidden = !notify || root.dataset.phoneNotificationsConfigured === "true";
    };

    form.addEventListener("input", update);
    form.addEventListener("change", update);
    update();
    window.setTimeout(update, 100);
  })();
<% end %>
