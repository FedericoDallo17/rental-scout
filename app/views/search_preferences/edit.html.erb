<main class="search-form-page">
  <header class="search-form-header">
    <p class="search-form-header__eyebrow"><%= t("searches.eyebrow") %></p>
    <h1><%= t("searches.edit_title") %></h1>
  </header>

  <%= render "form", search_preference: @search_preference, zones: @zones %>

  <div class="search-form-danger">
    <%= button_to t("searches.delete"), search_preference_path(@search_preference), method: :delete, class: "search-form-danger__button" %>
  </div>
</main>
