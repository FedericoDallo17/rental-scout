<% if @scraping_run.status == "running" %>
  <% content_for :head do %>
    <meta http-equiv="refresh" content="30">
  <% end %>
<% end %>

<main class="runs-page runs-workbench">
  <header class="runs-header">
    <div>
      <p class="runs-header__eyebrow"><%= t("admin.current_run.eyebrow") %></p>
      <h1><%= t("runs.run", id: @scraping_run.id) %></h1>
    </div>
    <div class="runs-header__tools">
      <%= link_to t("runs.all_runs"), admin_root_path, class: "runs-header__link" %>
      <%= link_to t("runs.feed"), listings_path, class: "runs-header__link" %>
    </div>
  </header>

  <%= turbo_stream_from @scraping_run %>
  <%= render "operational_run", scraping_run: @scraping_run %>
</main>
