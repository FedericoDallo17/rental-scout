<main class="runs-page runs-workbench">
  <header class="runs-header">
    <div>
      <p class="runs-header__eyebrow"><%= t("admin.users.eyebrow") %></p>
      <h1><%= t("admin.users.title") %></h1>
    </div>
    <div class="runs-header__tools">
      <%= link_to t("admin.dashboard"), admin_root_path, class: "runs-header__link" %>
      <p class="runs-header__count"><%= t("admin.users.count", count: @users.size) %></p>
    </div>
  </header>

  <section class="run-card">
    <table class="location-quality-table">
      <thead>
        <tr>
          <th><%= t("admin.users.name") %></th>
          <th><%= t("admin.users.email") %></th>
          <th><%= t("admin.users.searches") %></th>
          <th><%= t("admin.users.role") %></th>
          <th><%= t("admin.users.actions") %></th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <th scope="row"><%= [user.first_name, user.last_name].join(" ") %></th>
            <td><%= user.email %></td>
            <td><%= user.search_preferences_count %></td>
            <td><%= user.admin? ? t("admin.users.admin") : t("admin.users.user") %></td>
            <td>
              <% if user == current_user %>
                <span class="source-control-card__status source-control-card__status--active"><%= t("admin.users.current_account") %></span>
              <% else %>
                <%= button_to(
                  user.admin? ? t("admin.users.remove_admin") : t("admin.users.make_admin"),
                  admin_user_path(user),
                  method: :patch,
                  params: { user: { admin: user.admin? ? "0" : "1" } },
                  class: "source-control-card__button",
                  form: { data: { turbo_confirm: t("admin.users.role_confirmation", email: user.email) } }
                ) %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
</main>
