<main class="runs-page runs-workbench">
  <header class="runs-header">
    <div>
      <p class="runs-header__eyebrow"><%= t("runs.eyebrow") %></p>
      <h1><%= t("runs.title") %></h1>
    </div>
    <div class="runs-header__tools">
      <%= link_to t("runs.feed"), listings_path, class: "runs-header__link" %>
      <p class="runs-header__count"><%= t("count.run", count: @scraping_runs.size) %></p>
    </div>
  </header>

  <section class="run-card" aria-labelledby="location-quality-heading">
    <div class="run-card__summary">
      <div>
        <p class="runs-header__eyebrow"><%= t("runs.inventory_diagnostics") %></p>
        <h2 id="location-quality-heading"><%= t("runs.location_quality") %></h2>
      </div>
    </div>
    <dl class="run-card__facts">
      <div><dt><%= t("runs.spatial") %></dt><dd><%= t("runs.resolved", count: @location_quality.spatial_count) %></dd></div>
      <div><dt><%= t("runs.fallback") %></dt><dd><%= t("runs.provider_labels", count: @location_quality.fallback_count) %></dd></div>
      <div><dt><%= t("runs.unresolved") %></dt><dd><%= t("runs.unresolved_count", count: @location_quality.unresolved_count) %></dd></div>
      <div><dt><%= t("runs.mismatches") %></dt><dd><%= t("runs.provider_conflicts", count: @location_quality.provider_mismatch_count) %></dd></div>
    </dl>
    <table class="location-quality-table">
      <thead>
        <tr><th><%= t("runs.source") %></th><th><%= t("runs.total") %></th><th><%= t("runs.spatial") %></th><th><%= t("runs.fallback") %></th><th><%= t("runs.unresolved") %></th><th><%= t("runs.coverage") %></th></tr>
      </thead>
      <tbody>
        <% @location_quality.by_source.each do |source| %>
          <tr>
            <th scope="row"><%= source.source_name %></th>
            <td><%= source.total_count %></td>
            <td><%= source.spatial_count %></td>
            <td><%= source.fallback_count %></td>
            <td><%= source.unresolved_count %></td>
            <td><%= source.coverage_percentage %>%</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>

  <section class="source-controls" aria-label="<%= t("runs.sources_label") %>">
    <div class="source-controls__header">
      <p class="source-controls__eyebrow"><%= t("runs.source_controls") %></p>
      <h2><%= t("runs.listing_sources") %></h2>
    </div>

    <div class="source-controls__grid">
      <% @listing_sources.each do |source| %>
        <article class="source-control-card">
          <div>
            <h3><%= source.display_name %></h3>
          </div>
          <div class="source-control-card__actions">
            <span class="source-control-card__status source-control-card__status--<%= source.active? ? "active" : "inactive" %>">
              <%= source.active? ? t("runs.active") : t("runs.inactive") %>
            </span>
            <%= button_to(
              source.active? ? t("runs.deactivate") : t("runs.activate"),
              listing_source_path(source),
              method: :patch,
              params: { listing_source: { active: source.active? ? "0" : "1" } },
              class: "source-control-card__button"
            ) %>
          </div>
        </article>
      <% end %>
    </div>
  </section>

  <% if @scraping_runs.any? %>
    <section class="runs-list" aria-label="<%= t("runs.runs_label") %>">
      <% @scraping_runs.each do |run| %>
        <article class="run-card">
          <div class="run-card__summary">
            <div>
              <p class="run-card__started"><%= l(run.started_at, format: :short) %></p>
              <h2><%= t("runs.run", id: run.id) %></h2>
            </div>
            <span class="status-pill status-pill--<%= run.status.to_s.dasherize %>"><%= t("runs.statuses.#{run.status}", default: run.status.humanize) %></span>
          </div>

          <dl class="run-card__facts">
            <div>
              <dt><%= t("runs.seen") %></dt>
              <dd><%= t("runs.seen_count", count: run.listings_seen_count) %></dd>
            </div>
            <div>
              <dt><%= t("runs.new") %></dt>
              <dd><%= t("runs.new_count", count: run.listings_created_count) %></dd>
            </div>
            <div>
              <dt><%= t("runs.finished") %></dt>
              <dd><%= run.finished_at ? l(run.finished_at, format: :short) : t("runs.still_running") %></dd>
            </div>
          </dl>

          <% if run.error_message.present? %>
            <p class="run-card__error"><%= run.error_message %></p>
          <% end %>

          <div class="source-runs">
            <% run.scraping_source_runs.each do |source_run| %>
              <div class="source-run">
                <div>
                  <p class="source-run__name"><%= source_run.listing_source.display_name %></p>
                <p class="source-run__meta">
                  <%= t("runs.seen_count", count: source_run.listings_seen_count) %> ·
                  <%= t("runs.new_count", count: source_run.listings_created_count) %>
                </p>
                <p class="source-run__timeline">
                  <%= t("runs.started_at", time: l(source_run.started_at, format: :short)) %>
                  <% if source_run.finished_at %>
                    · <%= t("runs.finished_at", time: l(source_run.finished_at, format: :short)) %>
                  <% end %>
                </p>
              </div>
                <span class="status-pill status-pill--<%= source_run.status.to_s.dasherize %>"><%= t("runs.statuses.#{source_run.status}", default: source_run.status.humanize) %></span>
                <% if source_run.error_message.present? %>
                  <p class="source-run__error"><%= source_run.error_message %></p>
                <% end %>
              </div>
            <% end %>
          </div>
        </article>
      <% end %>
    </section>
  <% else %>
    <section class="empty-state">
      <h2><%= t("runs.empty_title") %></h2>
      <p><%= t("runs.empty_copy") %></p>
    </section>
  <% end %>
</main>
