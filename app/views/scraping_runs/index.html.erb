<main class="runs-page runs-workbench">
  <header class="runs-header">
    <div>
      <p class="runs-header__eyebrow">Scraper observability</p>
      <h1>Scraping Runs</h1>
    </div>
    <div class="runs-header__tools">
      <%= link_to "Feed", listings_path, class: "runs-header__link" %>
      <p class="runs-header__count"><%= pluralize(@scraping_runs.size, "run") %></p>
    </div>
  </header>

  <section class="run-card" aria-labelledby="location-quality-heading">
    <div class="run-card__summary">
      <div>
        <p class="runs-header__eyebrow">Inventory diagnostics</p>
        <h2 id="location-quality-heading">Location quality</h2>
      </div>
    </div>
    <dl class="run-card__facts">
      <div><dt>Spatial</dt><dd><%= @location_quality.spatial_count %> resolved</dd></div>
      <div><dt>Fallback</dt><dd><%= @location_quality.fallback_count %> provider labels</dd></div>
      <div><dt>Unresolved</dt><dd><%= @location_quality.unresolved_count %> unresolved</dd></div>
      <div><dt>Mismatches</dt><dd><%= @location_quality.provider_mismatch_count %> provider conflicts</dd></div>
    </dl>
  </section>

  <section class="source-controls" aria-label="Listing sources">
    <div class="source-controls__header">
      <p class="source-controls__eyebrow">Source controls</p>
      <h2>Listing Sources</h2>
    </div>

    <div class="source-controls__grid">
      <% @listing_sources.each do |source| %>
        <article class="source-control-card">
          <div>
            <h3><%= source.name %></h3>
            <p><%= source.adapter_key %></p>
          </div>
          <div class="source-control-card__actions">
            <span class="source-control-card__status source-control-card__status--<%= source.active? ? "active" : "inactive" %>">
              <%= source.active? ? "Active" : "Inactive" %>
            </span>
            <%= button_to(
              source.active? ? "Deactivate" : "Activate",
              listing_source_path(source),
              method: :patch,
              params: { listing_source: { active: source.active? ? "0" : "1" } },
              class: "source-control-card__button"
            ) %>
          </div>
        </article>
      <% end %>
    </div>
  </section>

  <% if @scraping_runs.any? %>
    <section class="runs-list" aria-label="Scraping runs">
      <% @scraping_runs.each do |run| %>
        <article class="run-card">
          <div class="run-card__summary">
            <div>
              <p class="run-card__started"><%= l(run.started_at, format: :short) %></p>
              <h2>Run #<%= run.id %></h2>
            </div>
            <span class="status-pill status-pill--<%= run.status.to_s.dasherize %>"><%= run.status %></span>
          </div>

          <dl class="run-card__facts">
            <div>
              <dt>Seen</dt>
              <dd><%= run.listings_seen_count %> seen</dd>
            </div>
            <div>
              <dt>New</dt>
              <dd><%= run.listings_created_count %> new</dd>
            </div>
            <div>
              <dt>Finished</dt>
              <dd><%= run.finished_at ? l(run.finished_at, format: :short) : "Still running" %></dd>
            </div>
          </dl>

          <% if run.error_message.present? %>
            <p class="run-card__error"><%= run.error_message %></p>
          <% end %>

          <div class="source-runs">
            <% run.scraping_source_runs.each do |source_run| %>
              <div class="source-run">
                <div>
                  <p class="source-run__name"><%= source_run.listing_source.name %></p>
                <p class="source-run__meta">
                  <%= source_run.listings_seen_count %> seen ·
                  <%= source_run.listings_created_count %> new
                </p>
                <p class="source-run__timeline">
                  Started <%= l(source_run.started_at, format: :short) %>
                  <% if source_run.finished_at %>
                    · Finished <%= l(source_run.finished_at, format: :short) %>
                  <% end %>
                </p>
              </div>
                <span class="status-pill status-pill--<%= source_run.status.to_s.dasherize %>"><%= source_run.status %></span>
                <% if source_run.error_message.present? %>
                  <p class="source-run__error"><%= source_run.error_message %></p>
                <% end %>
              </div>
            <% end %>
          </div>
        </article>
      <% end %>
    </section>
  <% else %>
    <section class="empty-state">
      <h2>No scraping runs yet.</h2>
      <p>Runs will appear here after the scraper job executes.</p>
    </section>
  <% end %>
</main>
