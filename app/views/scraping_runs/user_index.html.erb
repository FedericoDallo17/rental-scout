<main class="runs-page runs-workbench">
  <header class="runs-header">
    <div>
      <p class="runs-header__eyebrow"><%= t("runs.user_eyebrow") %></p>
      <h1><%= t("runs.user_title") %></h1>
    </div>
    <div class="runs-header__tools">
      <%= link_to t("runs.feed"), listings_path, class: "runs-header__link" %>
      <p class="runs-header__count"><%= t("count.run", count: @matched_runs.size) %></p>
    </div>
  </header>

  <section class="run-card" aria-labelledby="location-quality-heading">
    <div class="run-card__summary">
      <div>
        <p class="runs-header__eyebrow"><%= t("runs.inventory_diagnostics") %></p>
        <h2 id="location-quality-heading"><%= t("runs.location_quality") %></h2>
        <p class="location-quality-intro"><%= t("runs.location_quality_intro") %></p>
      </div>
    </div>
    <dl class="run-card__facts">
      <div><dt><%= t("runs.spatial") %></dt><dd><%= t("runs.resolved", count: @location_quality.spatial_count) %></dd></div>
      <div><dt><%= t("runs.fallback") %></dt><dd><%= t("runs.provider_labels", count: @location_quality.fallback_count) %></dd></div>
      <div><dt><%= t("runs.unresolved") %></dt><dd><%= t("runs.unresolved_count", count: @location_quality.unresolved_count) %></dd></div>
      <div><dt><%= t("runs.mismatches") %></dt><dd><%= t("runs.provider_conflicts", count: @location_quality.provider_mismatch_count) %></dd></div>
    </dl>
    <table class="location-quality-table">
      <thead>
        <tr><th><%= t("runs.source") %></th><th><%= t("runs.total") %></th><th><%= t("runs.spatial_short") %></th><th><%= t("runs.fallback_short") %></th><th><%= t("runs.unresolved_short") %></th><th><%= t("runs.coverage") %></th></tr>
      </thead>
      <tbody>
        <% @location_quality.by_source.each do |source| %>
          <tr>
            <th scope="row"><%= source.source_name %></th>
            <td><%= source.total_count %></td>
            <td><%= source.spatial_count %></td>
            <td><%= source.fallback_count %></td>
            <td><%= source.unresolved_count %></td>
            <td><%= source.coverage_percentage %>%</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>

  <% if @matched_runs.any? %>
    <section class="runs-list" aria-label="<%= t("runs.user_runs_label") %>">
      <% @matched_runs.each do |run| %>
        <% listing_count = @events_by_run_id.fetch(run.id).map(&:listing_id).uniq.size %>
        <article class="run-card">
          <div class="run-card__summary">
            <div>
              <p class="run-card__started"><%= l(run.started_at, format: :short) %></p>
              <h2><%= link_to t("runs.run", id: run.id), scraping_run_path(run) %></h2>
            </div>
            <span class="status-pill"><%= t("runs.your_matches", count: listing_count) %></span>
          </div>
          <p><%= t("runs.user_run_copy", count: listing_count) %></p>
          <%= link_to t("runs.view_matches"), scraping_run_path(run), class: "runs-header__link" %>
        </article>
      <% end %>
    </section>
  <% else %>
    <section class="empty-state">
      <h2><%= t("runs.no_user_runs") %></h2>
      <p><%= t("runs.no_user_runs_copy") %></p>
    </section>
  <% end %>
</main>
