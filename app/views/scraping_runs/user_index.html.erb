<main class="runs-page runs-workbench">
  <header class="runs-header">
    <div>
      <p class="runs-header__eyebrow"><%= t("runs.user_eyebrow") %></p>
      <h1><%= t("runs.user_title") %></h1>
    </div>
    <div class="runs-header__tools">
      <%= link_to t("runs.feed"), listings_path, class: "runs-header__link" %>
      <p class="runs-header__count"><%= t("runs.chime_count", count: @matched_runs.size) %></p>
    </div>
  </header>

  <% if @matched_runs.any? %>
    <section class="runs-list" aria-label="<%= t("runs.user_runs_label") %>">
      <% @matched_runs.each do |run| %>
        <% listing_count = @events_by_run_id.fetch(run.id).map(&:listing_id).uniq.size %>
        <article class="run-card">
          <div class="run-card__summary">
            <div>
              <p class="run-card__started"><%= l(run.started_at, format: :short) %></p>
              <h2><%= link_to t("runs.chime", id: run.id), scraping_run_path(run) %></h2>
            </div>
            <span class="status-pill"><%= t("runs.your_matches", count: listing_count) %></span>
          </div>
          <p><%= t("runs.user_run_copy", count: listing_count) %></p>
          <%= link_to t("runs.view_matches"), scraping_run_path(run), class: "runs-header__link" %>
        </article>
      <% end %>
    </section>
  <% else %>
    <section class="empty-state">
      <h2><%= t("runs.no_user_runs") %></h2>
      <p><%= t("runs.no_user_runs_copy") %></p>
    </section>
  <% end %>
</main>
