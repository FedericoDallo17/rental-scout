<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Rental Scout Lite" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body class="<%= user_signed_in? ? "app-body" : "auth-body" %>">
    <% if user_signed_in? %>
      <header class="app-header">
        <nav class="app-nav" aria-label="Account">
          <%= link_to root_path, class: "app-nav__brand" do %>
            <span class="app-nav__mark">RSL</span>
            <span>Rental Scout Lite</span>
          <% end %>

        <div class="app-user">
          <%= link_to "Runs", scraping_runs_path, class: "app-nav__link" %>
          <%= link_to "Notifications", edit_notification_settings_path, class: "app-nav__link" %>
          <span class="app-user__email"><%= current_user.email %></span>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete, form_class: "app-sign-out", class: "app-sign-out__button" %>
          </div>
        </nav>
      </header>

      <% flash.each do |key, message| %>
        <p class="flash app-flash flash--<%= key %>"><%= message %></p>
      <% end %>

      <%= yield %>
    <% else %>
      <main class="auth-shell">
        <section class="auth-card">
          <div class="auth-brand">Rental Scout Lite</div>

          <% flash.each do |key, message| %>
            <p class="flash auth-flash flash--<%= key %>"><%= message %></p>
          <% end %>

          <%= yield %>
        </section>
      </main>
    <% end %>
  </body>
</html>
