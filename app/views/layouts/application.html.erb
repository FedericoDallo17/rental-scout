<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || "Rental Scout Lite" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#17324d">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= tag.link rel: "manifest", href: "/manifest.json" %>

    <%= yield :head %>

    <% stylesheet_source = stylesheet_path("application") %>
    <% if Rails.env.development? %>
      <% stylesheet_source = "#{stylesheet_source}?v=#{Rails.root.join("public/stylesheets/application.css").mtime.to_i}" %>
    <% end %>
    <%= stylesheet_link_tag stylesheet_source, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= user_signed_in? ? "app-body" : "auth-body" %>">
    <% if user_signed_in? %>
      <header class="app-header">
        <nav class="app-nav" aria-label="<%= t("nav.account") %>">
          <%= link_to root_path, class: "app-nav__brand" do %>
            <span class="app-nav__mark">RSL</span>
            <span>Rental Scout Lite</span>
          <% end %>

        <div class="app-user">
          <%= link_to t("tracking.title"), listing_tracks_path, class: "app-nav__link" %>
          <%= link_to t("nav.runs"), scraping_runs_path, class: "app-nav__link" %>
          <% if current_user.admin? %>
            <%= link_to t("nav.admin"), admin_root_path, class: "app-nav__link" %>
          <% end %>
          <%= link_to t("nav.notifications"), edit_notification_settings_path, class: "app-nav__link" %>
          <%= render "layouts/language_switcher" %>
          <span class="app-user__email"><%= current_user.email %></span>
            <%= button_to t("nav.sign_out"), destroy_user_session_path, method: :delete, form_class: "app-sign-out", class: "app-sign-out__button" %>
          </div>
        </nav>
      </header>

      <% flash.each do |key, message| %>
        <p class="flash app-flash flash--<%= key %>"><%= message %></p>
      <% end %>

      <%= yield %>
    <% else %>
      <main class="auth-shell">
        <section class="auth-card">
          <div class="auth-card__topline">
            <div class="auth-brand">Rental Scout Lite</div>
            <%= render "layouts/language_switcher" %>
          </div>

          <% flash.each do |key, message| %>
            <p class="flash auth-flash flash--<%= key %>"><%= message %></p>
          <% end %>

          <%= yield %>
        </section>
      </main>
    <% end %>
  </body>
</html>
