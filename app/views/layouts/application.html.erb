<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || "Timbre" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "layouts/brand_head" %>

    <%= yield :head %>

    <% stylesheet_source = stylesheet_path("application") %>
    <% if Rails.env.development? %>
      <% stylesheet_source = "#{stylesheet_source}?v=#{Rails.root.join("public/stylesheets/application.css").mtime.to_i}" %>
    <% end %>
    <%= stylesheet_link_tag stylesheet_source, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= user_signed_in? ? "app-body" : "auth-body" %>">
    <% if user_signed_in? %>
      <header class="app-header">
        <nav class="app-nav" aria-label="<%= t("design.navigation") %>">
          <%= link_to root_path, class: "app-nav__brand" do %>
            <%= render "layouts/brand" %>
          <% end %>

          <div class="app-primary-navigation">
            <%= render "layouts/primary_navigation", mobile: false %>
          </div>

        <details class="app-account-menu" data-responsive-disclosure open>
          <summary class="app-account-menu__toggle"><%= t("design.menu") %><span aria-hidden="true">☰</span></summary>
          <div class="app-user">
          <% if current_user.admin? %>
            <%= link_to t("nav.admin"), admin_root_path, class: "app-nav__link", aria: { current: ("page" if current_page?(admin_root_path)) } %>
          <% end %>
          <%= render "layouts/language_switcher" %>
          <span class="app-user__email"><%= current_user.email %></span>
            <%= button_to t("nav.sign_out"), destroy_user_session_path, method: :delete, form_class: "app-sign-out", class: "app-sign-out__button" %>
          </div>
        </details>
        </nav>
      </header>

      <% flash.each do |key, message| %>
        <p class="flash app-flash flash--<%= key %>"><%= message %></p>
      <% end %>

      <%= yield %>
      <%= render "layouts/mobile_navigation" %>
    <% else %>
      <main class="auth-shell">
        <aside class="auth-story">
          <span class="auth-story__label">Montevideo, Uruguay</span>
          <h2><%= t("design.home_title") %></h2>
          <p><%= t("design.home_copy") %></p>
          <%= render "layouts/brand_motion" %>
          <span class="auth-story__footnote"><%= t("design.home_note") %></span>
        </aside>
        <section class="auth-card">
          <div class="auth-card__topline">
            <div class="auth-brand"><%= render "layouts/brand" %></div>
            <%= render "layouts/language_switcher" %>
          </div>

          <% flash.each do |key, message| %>
            <p class="flash auth-flash flash--<%= key %>"><%= message %></p>
          <% end %>

          <%= yield %>
        </section>
      </main>
    <% end %>
  </body>
</html>
