<div class="auth-header">
  <h1 class="auth-title"><%= t("auth.password.change_title") %></h1>
  <p class="auth-copy"><%= t("auth.password.change_copy") %></p>
</div>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "auth-form" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>

  <div class="auth-field">
    <div class="auth-field__label-row">
      <%= f.label :password, t("auth.password.new_password") %>
    <% if @minimum_password_length %>
        <span class="auth-hint"><%= t("auth.fields.minimum_characters", count: @minimum_password_length) %></span>
    <% end %>
    </div>
    <%= f.password_field :password, autofocus: true, autocomplete: "new-password" %>
  </div>

  <div class="auth-field">
    <%= f.label :password_confirmation, t("auth.password.confirm_new_password") %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
  </div>

  <%= f.submit t("auth.password.change_submit"), class: "auth-submit" %>
<% end %>

<%= render "devise/shared/links" %>
