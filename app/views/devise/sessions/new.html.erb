<div class="auth-header">
  <h1 class="auth-title"><%= t("auth.sign_in.title") %></h1>
  <p class="auth-copy"><%= t("auth.sign_in.copy") %></p>
</div>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth-form" }) do |f| %>
  <div class="auth-field">
    <%= f.label :email, t("auth.fields.email") %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
  </div>

  <div class="auth-field">
    <%= f.label :password, t("auth.fields.password") %>
    <%= f.password_field :password, autocomplete: "current-password" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <label class="auth-checkbox-row">
      <%= f.check_box :remember_me %>
      <span><%= t("auth.sign_in.remember") %></span>
    </label>
  <% end %>

  <%= f.button t("auth.sign_in.submit"), class: "auth-submit" %>
<% end %>

<%= render "devise/shared/links" %>
