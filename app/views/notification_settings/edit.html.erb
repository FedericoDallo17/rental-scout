<main class="notification-settings">
  <section class="notification-settings__panel">
    <p class="notification-settings__eyebrow"><%= t("notifications.account") %></p>
    <h1><%= t("notifications.title") %></h1>
    <p class="notification-settings__intro"><%= t("notifications.intro") %></p>

    <% notifications_ready = current_user.push_subscriptions.exists? || current_user.pushover_user_key.present? %>
    <div class="notification-settings__status notification-settings__status--<%= notifications_ready ? "ready" : "missing" %>">
      <strong><%= notifications_ready ? t("notifications.ready") : t("notifications.setup_needed") %></strong>
      <span><%= notifications_ready ? t("notifications.configured") : t("notifications.not_configured") %></span>
    </div>

    <div class="notification-settings__channels">
    <section
      class="notification-settings__channel notification-settings__web-push"
      data-web-push-settings
      data-vapid-public-key="<%= @vapid_public_key %>"
      data-create-url="<%= push_subscriptions_path %>"
      data-destroy-url="<%= current_push_subscriptions_path %>"
      data-enable-label="<%= t("notifications.web_push.enable") %>"
      data-disable-label="<%= t("notifications.web_push.disable") %>"
      data-enabled-label="<%= t("notifications.web_push.enabled") %>"
      data-denied-label="<%= t("notifications.web_push.denied") %>"
      data-unsupported-label="<%= t("notifications.web_push.unsupported") %>"
      data-error-label="<%= t("notifications.web_push.error") %>">
      <p class="notification-settings__channel-label"><%= t("notifications.option") %></p>
      <h2><%= t("notifications.web_push.title") %></h2>
      <p><%= t("notifications.web_push.copy") %></p>
      <button type="button" class="notification-settings__submit" data-web-push-toggle>
        <%= t("notifications.web_push.enable") %>
      </button>
      <p role="status" aria-live="polite" data-web-push-status></p>
      <section class="notification-settings__device-guides" data-device-guides>
        <h3><%= t("notifications.web_push.guides_title") %></h3>
        <% %i[ios android mac windows].each do |device| %>
          <details class="notification-settings__disclosure" data-device-guide="<%= device %>">
            <summary><%= t("notifications.web_push.guides.#{device}.title") %></summary>
            <p><%= t("notifications.web_push.guides.#{device}.intro") %></p>
            <ol>
              <% t("notifications.web_push.guides.#{device}.steps").each do |step| %>
                <li><%= step %></li>
              <% end %>
            </ol>
          </details>
        <% end %>
      </section>
    </section>

    <section class="notification-settings__channel notification-settings__pushover">
      <p class="notification-settings__channel-label"><%= t("notifications.option") %></p>
      <h2><%= t("notifications.pushover_title") %></h2>
      <p><%= t("notifications.pushover_copy") %></p>

      <% if current_user.pushover_user_key.present? %>
        <p class="notification-settings__channel-state notification-settings__channel-state--ready">
          <%= t("notifications.pushover_connected") %>
        </p>
        <details class="notification-settings__disclosure">
          <summary><%= t("notifications.replace_key") %></summary>
          <%= form_with url: notification_settings_path, method: :patch, scope: :user, class: "notification-settings__form" do |form| %>
            <div class="notification-settings__field">
              <%= form.label :pushover_user_key, t("notifications.new_key") %>
              <%= form.password_field :pushover_user_key, value: nil, autocomplete: "off", spellcheck: false %>
              <p><%= t("notifications.key_validation_hint") %></p>
            </div>
            <%= form.submit t("notifications.replace_key_action"), class: "notification-settings__submit" %>
          <% end %>
        </details>

        <details class="notification-settings__disclosure">
          <summary><%= t("notifications.about_pushover") %></summary>
          <%= render "pushover_explanation" %>
        </details>

        <div class="notification-settings__danger">
          <div>
            <strong><%= t("notifications.remove_title") %></strong>
            <p><%= t("notifications.remove_copy") %></p>
          </div>
          <%= button_to t("notifications.remove"), notification_settings_path,
            method: :delete,
            class: "notification-settings__remove-button",
            data: { confirm: t("notifications.remove_confirmation"), turbo_confirm: t("notifications.remove_confirmation") } %>
        </div>
      <% else %>
        <p class="notification-settings__channel-state"><%= t("notifications.pushover_not_connected") %></p>
        <%= render "pushover_explanation" %>

        <ol class="notification-settings__steps">
          <li>
            <strong><%= t("notifications.steps.install_title") %></strong>
            <span><%= t("notifications.steps.install_copy") %></span>
            <%= link_to t("notifications.learn_more"), "https://pushover.net/", target: "_blank", rel: "noopener noreferrer" %>
          </li>
          <li>
            <strong><%= t("notifications.steps.key_title") %></strong>
            <span><%= t("notifications.steps.key_copy") %></span>
            <%= link_to t("notifications.get_key"), "https://pushover.net/login", target: "_blank", rel: "noopener noreferrer" %>
          </li>
          <li>
            <strong><%= t("notifications.steps.connect_title") %></strong>
            <span><%= t("notifications.steps.connect_copy") %></span>
          </li>
        </ol>

        <%= form_with url: notification_settings_path, method: :patch, scope: :user, class: "notification-settings__form" do |form| %>
          <div class="notification-settings__field">
            <%= form.label :pushover_user_key, t("notifications.key") %>
            <%= form.password_field :pushover_user_key, value: nil, autocomplete: "off", spellcheck: false, required: true %>
            <p><%= t("notifications.key_validation_hint") %></p>
          </div>
          <%= form.submit t("notifications.connect"), class: "notification-settings__submit" %>
        <% end %>
      <% end %>
    </section>
    </div>

    <section class="notification-settings__searches" aria-labelledby="notification-searches-title">
      <h2 id="notification-searches-title"><%= t("notifications.searches_title") %></h2>
      <p><%= t("notifications.searches_count", count: @notification_searches.size) %></p>
      <% if @notification_searches.any? %>
        <ul>
          <% @notification_searches.each do |search| %>
            <li><%= link_to search.name, edit_search_preference_path(search) %></li>
          <% end %>
        </ul>
      <% else %>
        <p><%= t("notifications.no_enabled_searches") %></p>
        <%= link_to t("notifications.create_search"), new_search_preference_path, class: "notification-settings__inline-link" %>
      <% end %>
    </section>

    <% if notifications_ready %>
      <div class="notification-settings__connected-actions">
        <%= button_to t("notifications.send_test"), test_delivery_notification_settings_path,
          method: :post,
          class: "notification-settings__submit" %>
        <%= link_to t("notifications.back"), listings_path, class: "notification-settings__cancel" %>
      </div>
    <% end %>

  </section>

  <aside class="notification-settings__aside">
    <p class="notification-settings__eyebrow"><%= t("notifications.privacy") %></p>
    <h2><%= t("notifications.private_title") %></h2>
    <p><%= t("notifications.private_copy") %></p>
    <p><%= t("notifications.validation_copy") %></p>

    <section class="notification-settings__troubleshooting" aria-labelledby="notification-troubleshooting-title">
      <h2 id="notification-troubleshooting-title"><%= t("notifications.troubleshooting_title") %></h2>
      <p><%= t("notifications.troubleshooting_intro") %></p>
      <ul>
        <li><%= t("notifications.troubleshooting_device") %></li>
        <li><%= t("notifications.troubleshooting_muted") %></li>
        <li><%= t("notifications.troubleshooting_key") %></li>
        <li><%= t("notifications.troubleshooting_searches") %></li>
      </ul>
    </section>
  </aside>
</main>
