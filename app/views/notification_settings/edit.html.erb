<main class="notification-settings">
  <section class="notification-settings__panel">
    <p class="notification-settings__eyebrow"><%= t("notifications.account") %></p>
    <h1><%= t("notifications.title") %></h1>
    <p class="notification-settings__intro">
      <%= t("notifications.intro") %>
    </p>

    <div class="notification-settings__status notification-settings__status--<%= current_user.pushover_user_key.present? ? "ready" : "missing" %>">
      <strong><%= current_user.pushover_user_key.present? ? t("notifications.ready") : t("notifications.setup_needed") %></strong>
      <span><%= current_user.pushover_user_key.present? ? t("notifications.configured") : t("notifications.not_configured") %></span>
    </div>

    <%= form_with url: notification_settings_path, method: :patch, scope: :user, class: "notification-settings__form" do |form| %>
      <div class="notification-settings__field">
        <%= form.label :pushover_user_key, current_user.pushover_user_key.present? ? t("notifications.replace_key") : t("notifications.key") %>
        <%= form.password_field :pushover_user_key, value: nil, autocomplete: "off", spellcheck: false %>
        <p><%= t("notifications.blank_hint") %></p>
      </div>

      <% if current_user.pushover_user_key.present? %>
        <label class="notification-settings__remove">
          <%= form.check_box :remove_pushover_key %>
          <span><%= t("notifications.remove") %></span>
        </label>
      <% end %>

      <div class="notification-settings__actions">
        <%= form.submit t("notifications.save"), class: "notification-settings__submit" %>
        <%= link_to t("notifications.back"), listings_path, class: "notification-settings__cancel" %>
      </div>
    <% end %>
  </section>

  <aside class="notification-settings__aside">
    <p class="notification-settings__eyebrow"><%= t("notifications.privacy") %></p>
    <h2><%= t("notifications.private_title") %></h2>
    <p><%= t("notifications.private_copy") %></p>
    <p><%= t("notifications.no_test") %></p>
  </aside>
</main>
